<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nsvNewDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <!-- Přepínač odběrného místa (< [ikona domu] Domov >) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <ImageButton
                    android:id="@+id/btnPrevSubscriptionPoint"
                    android:layout_width="36dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_dashboard_switcher_btn"
                    android:contentDescription="@string/btn_left_content_description_sum_invoices"
                    android:src="@drawable/ic_chevron_left_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_subscription_point"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSubscriptionPointName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        tools:text="Domov" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNextSubscriptionPoint"
                    android:layout_width="36dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_dashboard_switcher_btn"
                    android:contentDescription="@string/btn_right_content_description_sum_invoices"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Upozornění při neexistujícím odběrném místě -->
        <TextView
            android:id="@+id/tvAlertNoSubscriptionPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:text="@string/create_place"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Dvousloupcový kontejner sekcí v režimu na šířku (landscape) -->
        <LinearLayout
            android:id="@+id/llDashboardColumnsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            tools:ignore="InconsistentLayout">

            <LinearLayout
                android:id="@+id/llDashboardLeftColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/include_new_dashboard_sections" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDashboardRightColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
