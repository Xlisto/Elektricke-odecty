<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false"
    android:padding="@dimen/price_list_editor_root_padding">

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZpet"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zpet" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUloz"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/ulozit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buttons"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left ScrollView -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card: Validity Range -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvDateInvoiceListDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnPlatnostRange"
                            android:text="@string/platnost_cenik"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlatnostRange"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:icon="@drawable/ic_calendar_24"
                            app:iconGravity="start"
                            tools:text="01.01.2026 – 31.12.2026" />

                        <Button
                            android:id="@+id/btnPlatnostOD"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="@string/datum_cislem"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnPlatnostDO"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="@string/datum_cislem"
                            android:visibility="gone" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Basic Price List Info & Distribution -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <cz.xlisto.elektrodroid.ownview.LabelEditText
                            android:id="@+id/ivRada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            app:direction="vertical"
                            app:hintText="@string/produktova_rada"
                            app:label="@string/produktova_rada" />

                        <cz.xlisto.elektrodroid.ownview.LabelEditText
                            android:id="@+id/ivProdukt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/ivRada"
                            android:inputType="text"
                            android:minHeight="48dp"
                            app:direction="vertical"
                            app:hintText="Produkt"
                            app:label="@string/produkt" />

                        <cz.xlisto.elektrodroid.ownview.LabelEditText
                            android:id="@+id/ivDodavatel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/ivProdukt"
                            android:inputType="text"
                            android:minHeight="48dp"
                            app:direction="vertical"
                            app:hintText="E.ON"
                            app:label="@string/dodavatel" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/ivDodavatel"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvUzemiSeznam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:labelFor="@+id/spDistribucniUzemiSeznam"
                                android:text="@string/distribucni_uzemi"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginBottom="4dp"
                                android:layout_toEndOf="@id/tvUzemiSeznam"
                                android:gravity="end"
                                android:labelFor="@+id/spSazbaSeznam"
                                android:text="@string/sazba_distribuce"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Spinner
                                android:id="@+id/spDistribucniUzemiSeznam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvUzemiSeznam"
                                android:entries="@array/distribucni_uzemi"
                                android:minWidth="160dp"
                                android:minHeight="48dp" />

                            <Spinner
                                android:id="@+id/spSazbaSeznam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvUzemiSeznam"
                                android:layout_alignParentEnd="true"
                                android:layout_toEndOf="@id/spDistribucniUzemiSeznam"
                                android:entries="@array/sazby"
                                android:minWidth="140dp"
                                android:minHeight="48dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReloadRegulPriceList"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/spSazbaSeznam"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="12dp"
                                android:text="@string/reload_prices" />

                            <RelativeLayout
                                android:id="@+id/rlNoPriceList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/btnReloadRegulPriceList"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_alert_card"
                                android:padding="12dp"
                                android:visibility="gone">

                                <View
                                    android:id="@+id/vAlertStripe"
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentStart="true"
                                    android:background="@color/color_red_alert" />

                                <ImageView
                                    android:id="@+id/ivAlert"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_toEndOf="@id/vAlertStripe"
                                    android:contentDescription="@string/alert"
                                    android:src="@drawable/ic_warning"
                                    app:tint="@color/color_red_alert" />

                                <TextView
                                    android:id="@+id/tvNoPriceListTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@id/ivAlert"
                                    android:layout_marginStart="8dp"
                                    android:layout_toEndOf="@id/ivAlert"
                                    android:text="@string/alert_regulated_prices_title_every_year"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNoPriceListDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/tvNoPriceListTitle"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginTop="4dp"
                                    android:layout_toEndOf="@id/vAlertStripe"
                                    android:lineSpacingExtra="2dp"
                                    android:text="@string/no_price_list"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                            </RelativeLayout>

                        </RelativeLayout>

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Unregulated Supply Price -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/cena_za_dodavku"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivVT"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ems="6"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/vt2" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivNT"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ems="6"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/nt2" />
                        </LinearLayout>

                        <cz.xlisto.elektrodroid.ownview.LabelEditText
                            android:id="@+id/ivPlat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ems="6"
                            android:gravity="end"
                            android:inputType="numberDecimal"
                            android:maxEms="5"
                            app:hintText="@string/nuly"
                            app:label="@string/mesicni_plat" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- Right ScrollView -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card: Regulated Distribution Price -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/cena_za_distribuci"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivVT1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ems="6"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="6"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/vt2" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivNT1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ems="6"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="6"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/nt2" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Circuit Breaker Prices -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvMesicniPlatDleJistice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/mesicni_plat_za_prikon"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swJistic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvMesicniPlatDleJistice"
                            android:layout_marginBottom="8dp"
                            android:maxWidth="300dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/swJistic"
                            android:orientation="vertical">

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ0"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_do_10" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_10" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_16" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_20" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_25" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_32" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_40" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ7"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_50" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_63" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ11"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_80" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ12"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_100" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ13"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_125" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ14"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_160" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_63_za_A" />

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivJ9"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="5"
                                android:gravity="end"
                                android:inputType="numberDecimal"
                                android:maxEms="5"
                                android:minHeight="48dp"
                                app:hintText="@string/nuly"
                                app:label="@string/jistic_nad_25_za_A" />

                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Other Regulated Services -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/cena_za_ostatni_regulovane_sluzby"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <cz.xlisto.elektrodroid.ownview.LabelEditText
                            android:id="@+id/ivSystemoveSluzby"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:inputType="numberDecimal"
                            android:maxEms="3"
                            android:minHeight="48dp"
                            app:direction="vertical"
                            app:hintText="@string/nuly"
                            app:label="@string/systemove_sluzby" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <cz.xlisto.elektrodroid.ownview.LabelEditText
                                android:id="@+id/ivCinnostOperatoraTrhu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
