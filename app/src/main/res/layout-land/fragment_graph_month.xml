<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <cz.xlisto.elektrodroid.modules.graphmonth.GraphMonthView
        android:id="@+id/graphMonthView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_toStartOf="@id/ln_buttons_monthly_graph"
        android:background="@color/color_graph_background" />

    <LinearLayout
        android:id="@+id/ln_buttons_monthly_graph"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="false"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="false"
        android:background="?attr/colorSurfaceContainer"
        android:padding="2dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/imgBtnType"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_type"
            android:tooltipText="@string/description_btn_type"
            tools:targetApi="o"
            android:cropToPadding="false"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_column" />

        <ImageButton
            android:id="@+id/imgBtnPeriod"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_period"
            android:tooltipText="@string/description_btn_period"
            tools:targetApi="o"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_year" />

        <ImageButton
            android:id="@+id/imgBtnVT"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_vt"
            android:tooltipText="@string/description_btn_vt"
            tools:targetApi="o"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_vt_on" />

        <ImageButton
            android:id="@+id/imgBtnNT"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_nt"
            android:tooltipText="@string/description_btn_nt"
            tools:targetApi="o"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_nt_on" />

        <ImageButton
            android:id="@+id/imgBtnLeft"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_zoom_in"
            android:tooltipText="@string/description_btn_zoom_in"
            tools:targetApi="o"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_zoom_minus" />

        <ImageButton
            android:id="@+id/imgBtnRight"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_zoom_out"
            android:tooltipText="@string/description_btn_zoom_out"
            tools:targetApi="o"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_zoom_plus" />
    </LinearLayout>

</RelativeLayout>