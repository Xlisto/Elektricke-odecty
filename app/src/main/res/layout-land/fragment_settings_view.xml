<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dva sloupce vedle sebe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- ========== LEVÝ SLOUPEC: Upozornění HDO ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_group_notifications"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <CheckBox
                    android:id="@+id/chNotificationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/notifications_enabled" />

                <CheckBox
                    android:id="@+id/chExactAlarmPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/exact_alarms_enabled" />

                <CheckBox
                    android:id="@+id/chUseSetAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/hdo_use_set_alarm" />

                <TextView
                    android:id="@+id/tvUseSetAlarmDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/hdo_use_set_alarm_description"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

            </LinearLayout>

            <!-- Vodorovný oddělovač uvnitř levého sloupce -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/listDivider" />

            <!-- Skupina: Připojení -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_group_connection"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAllowMobileData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/allow_mobile_data" />

            </LinearLayout>

        </LinearLayout>

        <!-- Svislý oddělovač mezi sloupci -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/listDivider" />

        <!-- ========== PRAVÝ SLOUPEC: Navigace + Notifikace odečtu ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <!-- Skupina: Zobrazení navigace -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_group_navigation"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShowFab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/show_fab_button" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShowBottomNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/show_bottom_nav" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShowLeftNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/show_nav" />

            </LinearLayout>

            <!-- Vodorovný oddělovač uvnitř pravého sloupce -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/listDivider" />

            <!-- Skupina: Notifikace pro zápis odečtu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/reading_notification_frequency"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <CheckBox
                    android:id="@+id/chReadingNotificationEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/reading_notification_enabled" />

                <!-- Spinner pro frekvenci -->
                <Spinner
                    android:id="@+id/spinnerReadingNotificationFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:minHeight="48dp"
                    android:entries="@array/reading_notification_frequency_array"
                    android:contentDescription="@string/reading_notification_frequency" />

                <!-- Měsíčně: den v měsíci -->
                <LinearLayout
                    android:id="@+id/layoutMonthlyDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/reading_notification_day_of_month"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etDayOfMonth"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:hint="1-31"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- Týdně: den v týdnu -->
                <LinearLayout
                    android:id="@+id/layoutWeeklyDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reading_notification_day_of_week"
                        android:textAppearance="?android:attr/textAppearanceSmall" />

                    <Spinner
                        android:id="@+id/spinnerDayOfWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:entries="@array/day_of_week_array"
                        android:contentDescription="@string/reading_notification_day_of_week" />
                </LinearLayout>

                <!-- Čas notifikace (společný pro obě varianty) -->
                <LinearLayout
                    android:id="@+id/layoutNotificationTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/reading_notification_time"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvNotificationTime"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:text="08:00"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="8dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>

