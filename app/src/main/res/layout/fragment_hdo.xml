<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <Button
        android:id="@+id/btnAddHdo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="@string/add_hdo" />

    <!-- HDO Clock & Status Card Block -->
    <LinearLayout
        android:id="@+id/cardHdoClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/shape_monthly_reading_gray"
        android:orientation="vertical"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/lnHdoClockContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_item"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Header Row: Title + Minimize/Maximize Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/btnMinimizeHdo"
                    android:text="@string/time_meter"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnMinimizeHdo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/minimize"
                    android:padding="6dp"
                    app:srcCompat="@drawable/ic_expand_more_24" />

            </RelativeLayout>

            <!-- Time Display & Lightbulb -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvTimeHdo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/imageViewIconNT"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imageViewIconNT"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/image_destription_nt"
                    app:srcCompat="@drawable/nt_on" />

            </RelativeLayout>

            <!-- Expandable Details Container -->
            <LinearLayout
                android:id="@+id/llHdoClockDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvTimeDifference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_horizontal"
                    android:text="@string/different_time" />

                <LinearLayout
                    android:id="@+id/llRelaysStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Separate CardView for Relay Filter and Validity Date -->
    <LinearLayout
        android:id="@+id/cardHdoFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardHdoClock"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/shape_monthly_reading_gray"
        android:orientation="vertical"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_item"
            android:orientation="vertical"
            android:padding="6dp">

            <Spinner
                android:id="@+id/spReleSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/description_rele"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/tvHdoDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHdo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAddHdo"
        android:layout_below="@id/cardHdoFilter"
        android:layout_alignParentStart="true"
        android:layoutAnimation="@anim/layout_animation_fall_down"
        android:contentDescription="@string/description_hdo_list"
        android:padding="2dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabHdo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="@dimen/fab_margin"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginStart="@dimen/fab_margin"
        android:layout_marginTop="@dimen/fab_margin"
        android:contentDescription="@string/image_destription_new_hdo"
        android:src="@drawable/ic_content_add"
        app:backgroundTint="@color/floatingButtonTint"
        app:tint="@color/floatingButtonBackground" />

    <TextView
        android:id="@+id/tvNotValidHDO"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:textColor="#ff0000"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlertHdo"
        style="@style/StyleTvAlert"
        android:text="@string/create_place" />

</RelativeLayout>
