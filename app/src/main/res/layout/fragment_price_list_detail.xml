<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- KARTA 1: Základní informace a Platnost -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Datum platnosti -->
                <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                    android:id="@+id/ldnPlatnost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:item="@string/empty"
                    app:label_price_item="@string/sp_datum_platnosti" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- 2-sloupcový řádek 1: Dodavatel | Území -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldnDodavatel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/empty"
                        app:label_price_item="@string/dodavatel" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldnUzemi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/empty"
                        app:label_price_item="@string/distribucni_uzemi" />
                </LinearLayout>

                <!-- 2-sloupcový řádek 2: Produktová řada | Produkt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldnRada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/empty"
                        app:label_price_item="@string/produktova_rada" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldnProdukt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/empty"
                        app:label_price_item="@string/produkt" />
                </LinearLayout>

                <!-- Řádek 3: Sazba -->
                <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                    android:id="@+id/ldnSazba"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:item="@string/empty"
                    app:label_price_item="@string/sazba_distribuce" />

                <!-- Poznámka v červeném/zvýrazněném poli -->
                <TextView
                    android:id="@+id/tvPoznamkaDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_background_red"
                    android:padding="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTA 2: Cena za dodávku elektřiny (neregulovaná) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/cena_za_dodavku"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <!-- 3 sloupce: VT | NT | Měsíční plat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Sloupec VT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                            android:id="@+id/ldn_VT_dodavka"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:item="@string/kc_MWh"
                            app:label_price_item="@string/vt" />

                        <TextView
                            android:id="@+id/tvPoznamkaVT"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            tools:text="Cenový strop: 5000,00"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Sloupec NT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                            android:id="@+id/ldn_NT_dodavka"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:item="@string/kc_MWh"
                            app:label_price_item="@string/nt" />

                        <TextView
                            android:id="@+id/tvPoznamkaNT"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            tools:text="Cenový strop: 5000,00"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Sloupec Měsíční plat -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                            android:id="@+id/ldn_staly_plat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:item="@string/kc_mesic"
                            app:label_price_item="@string/mesicni_plat2" />

                        <TextView
                            android:id="@+id/tvPoznamkaPlat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            tools:text="Cenový strop: 130,00"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTA 3: Cena za distribuci elektřiny (regulovaná) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/cena_za_distribuci"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_VT_distribuce"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/kc_MWh"
                        app:label_price_item="@string/vt" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_NT_distribuce"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:item="@string/kc_MWh"
                        app:label_price_item="@string/nt" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTA 4: Platba za jistič -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/mesicni_plat_za_jistic"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <!-- Mřížka jističů po 2 v řádku -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:orientation="horizontal">

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_do_10" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_10" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_16" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_20" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_25" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_32" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_40" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_50" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_63" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_63_za_A" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_80" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_100" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_125" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J13"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_160" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_J14"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_mesic"
                        app:label_price_item="@string/jistic_nad_160" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTA 5: Ostatní poplatky a daně -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/cena_za_ostatni_regulovane_sluzby"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:orientation="horizontal">

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_systemove_sluzby"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_MWh"
                        app:label_price_item="@string/systemove_sluzby" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_OTE"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_om"
                        app:label_price_item="@string/cinnost_operatora_trhu" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_POZE1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_1A"
                        app:label_price_item="@string/poze_dle_jistice" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_POZE2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_MWh"
                        app:label_price_item="@string/poze_dle_spotreby" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_dan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/kc_MWh"
                        app:label_price_item="@string/dan_elektriny" />

                    <cz.xlisto.elektrodroid.ownview.LabelPriceDetail
                        android:id="@+id/ldn_DPH"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:item="@string/empty"
                        app:label_price_item="@string/dph" />
                </GridLayout>

                <TextView
                    android:id="@+id/tvPoznamkaPOZE1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPoznamkaPOZE2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPoznamkaOTE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
