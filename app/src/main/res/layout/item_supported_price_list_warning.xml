<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/supported_pricelist_warning_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/supported_pricelist_warning_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/supported_price_lists_warning_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/supported_pricelist_warning_text"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_warning_24"
            app:drawableTint="@color/supported_pricelist_warning_icon" />

        <TextView
            android:id="@+id/tvWarningMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/supported_price_lists_warning_message"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/supported_pricelist_warning_text" />

        <LinearLayout
            android:id="@+id/layoutWarningToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvWarningToggleLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/supported_price_lists_warning_toggle"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/supported_pricelist_warning_text"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivWarningExpandIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more_24"
                app:tint="@color/supported_pricelist_warning_icon" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWarningDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/supported_price_lists_requirement_supply"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/supported_pricelist_warning_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/supported_price_lists_requirement_fixed"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/supported_pricelist_warning_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/supported_price_lists_requirement_distribution"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/supported_pricelist_warning_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/supported_price_lists_requirement_breaker"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/supported_pricelist_warning_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/supported_price_lists_requirement_other"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/supported_pricelist_warning_text" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
