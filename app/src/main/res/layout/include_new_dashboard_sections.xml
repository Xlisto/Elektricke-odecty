<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. KARTA: AKTUÁLNÍ CENA ELEKTŘINY -->
    <FrameLayout
        android:id="@+id/cardCurrentPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dashboard_price_card">

        <!-- Dekorativní sloup vysokého napětí na pozadí vpravo -->
        <ImageView
            android:layout_width="76dp"
            android:layout_height="136dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/ic_electric_pylon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- Hlavička karty -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bolt_24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/dashboard_current_price_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Přepínače: Celková / Neregulovaná cena + DPH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swPriceTotalKwh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="36dp"
                    android:text="@string/dashboard_price_total_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swPriceVat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:checked="true"
                    android:minHeight="36dp"
                    android:text="@string/dashboard_price_vat_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Dva boxy: VT a NT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="44dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Box VT -->
                <LinearLayout
                    android:id="@+id/boxPriceVt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_price_box_inactive"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelVt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/kwh_vt"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivCheckVt"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_circle_24"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPriceVtValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="6,20" />

                        <TextView
                            android:id="@+id/tvPriceVtUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:text="@string/dashboard_price_kwh_unit"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Box NT -->
                <LinearLayout
                    android:id="@+id/boxPriceNt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_price_box_active"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelNt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/kwh_nt"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivCheckNt"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_circle_24"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPriceNtValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="4,10" />

                        <TextView
                            android:id="@+id/tvPriceNtUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:text="@string/dashboard_price_kwh_unit"
                            android:textColor="@android:color/white"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Spodní řádek: HDO další přepnutí -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock_24"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvHdoNextSwitchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/dashboard_hdo_next_switch_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvHdoNextSwitchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/dashboard_teal_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    tools:text="21:41" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 2. SEKCE: 3 RYCHLÉ DLAŽDICE (Měsíční odečty se stavem měřidla | 24h HDO hodiny | Nový odečet) -->
    <LinearLayout
        android:id="@+id/layoutQuickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Dlaždice 1: Měsíční odečty + grafický stav elektroměru (VT / NT) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickMonthlyReadings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="102dp"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dashboard_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bar_chart_24"
                        app:tint="@color/dashboard_teal_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/month_reads"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Stav měřidla VT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="@string/kwh_vt"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />

                    <cz.xlisto.elektrodroid.ownview.NumbersMeter
                        android:id="@+id/numbersMeterDashboardVT"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Stav měřidla NT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="@string/kwh_nt"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />

                    <cz.xlisto.elektrodroid.ownview.NumbersMeter
                        android:id="@+id/numbersMeterDashboardNT"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dlaždice 2: 24hodinové analogové hodiny HDO (nahrazuje Týdenní přehled) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickHdoClock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="102dp"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dashboard_card_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp">

                <cz.xlisto.elektrodroid.modules.dashboard.DashboardHdoClockView
                    android:id="@+id/viewHdoClock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dlaždice 3: Nový odečet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickNewReading"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="102dp"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dashboard_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add_circle_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/dashboard_quick_new_reading"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. KARTA: SPOTŘEBA OBDOBÍ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPeriodConsumption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/dashboard_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/dashboard_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- Hlavička: Ikona + Spotřeba období + datum od-do -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_24"
                    app:tint="@color/dashboard_teal_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_consumption_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPeriodDateRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="19.05.2026 – 31.08.2026" />
            </LinearLayout>

            <!-- Tělo: Vlevo VT/NT hodnoty + pruh, vpravo prstencový graf -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Řádek VT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="10dp"
                            android:background="@color/dashboard_teal_vt" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/kwh_vt"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPeriodVtValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            tools:text="639 kWh" />
                    </LinearLayout>

                    <!-- Řádek NT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="10dp"
                            android:background="@color/dashboard_teal_nt" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/kwh_nt"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPeriodNtValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            tools:text="671 kWh" />
                    </LinearLayout>

                    <!-- Horizontální poměrový pruh -->
                    <cz.xlisto.elektrodroid.modules.dashboard.DashboardPeriodBarView
                        android:id="@+id/viewPeriodBar"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- Donut graf vpravo -->
                <cz.xlisto.elektrodroid.modules.dashboard.DashboardDonutChartView
                    android:id="@+id/viewPeriodDonut"
                    android:layout_width="86dp"
                    android:layout_height="86dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. KARTA: PŘEHLED SPOTŘEBY (Měsíční / Roční) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConsumptionOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/dashboard_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/dashboard_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bar_chart_24"
                    app:tint="@color/dashboard_teal_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_consumption_overview_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConsumptionChartSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_monthly_consumption_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swConsumptionYearly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/dashboard_toggle_yearly"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <cz.xlisto.elektrodroid.modules.dashboard.DashboardConsumptionBarChartView
                android:id="@+id/viewConsumptionBarChart"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. KARTA: VYÚČTOVÁNÍ & POSLEDNÍ FAKTURY -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBilling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/dashboard_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/dashboard_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- Hlavička Vyúčtování -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calculator_24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/dashboard_billing_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBillingPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp"
                    tools:text="Období: 19.05. – 31.08.2026" />
            </LinearLayout>

            <!-- Zálohy | Náklady | Přeplatek/Nedoplatek -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Zálohy -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_advances_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBillingAdvances"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        tools:text="18 000 Kč" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/dashboard_divider" />

                <!-- Náklady -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_costs_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBillingCosts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        tools:text="7 748 Kč" />
                </LinearLayout>

                <!-- Přeplatek / Nedoplatek -->
                <LinearLayout
                    android:id="@+id/boxBillingBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_dashboard_overpayment"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:id="@+id/tvBillingBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_overpayment_label"
                        android:textColor="@color/dashboard_overpayment_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBillingBalanceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:textColor="@color/dashboard_overpayment_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="10 252 Kč" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/dashboard_divider" />

            <!-- Poslední faktury -->
            <LinearLayout
                android:id="@+id/layoutLastInvoicesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_receipt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/dashboard_last_invoices_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llInvoicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@color/dashboard_divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
