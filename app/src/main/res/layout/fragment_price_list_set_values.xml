<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zdroj spotřeby"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <RadioGroup
            android:id="@+id/rgSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSourceManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Ruční zadání VT a NT" />

            <RadioButton
                android:id="@+id/rbSourceHistoryYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Načíst z odečtů za konkrétní rok" />

            <RadioButton
                android:id="@+id/rbSourceHistoryAvg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Průměrná roční spotřeba z historie" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/llYearSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Rok: "
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <Spinner
                android:id="@+id/spHistoryYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDataQualityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutline" />

        <cz.xlisto.elektrodroid.ownview.LabelEditText
            android:id="@+id/letVT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            app:direction="vertical"
            app:hintText="@string/_1"
            app:label="@string/spotreba_vysokeho_tarifu" />

        <cz.xlisto.elektrodroid.ownview.LabelEditText
            android:id="@+id/letNT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            app:direction="vertical"
            app:hintText="@string/_1"
            app:label="@string/spotreba_nizkeho_tarifu" />

        <cz.xlisto.elektrodroid.ownview.LabelEditText
            android:id="@+id/letMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            app:direction="vertical"
            app:hintText="@string/_1"
            app:label="@string/pocet_mesicu" />

        <TextView
            android:id="@+id/tvFazePrikon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/faze_x_prikon" />

        <LinearLayout
            android:id="@+id/lnPhaze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/letPhaze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/_3"
                android:importantForAutofill="no"
                android:inputType="number|numberDecimal"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/tvX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/x" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/letPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/_25"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dalsi_sluzby_neuvedene" />

        <LinearLayout
            android:id="@+id/lnServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/letServicesL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/_0"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/letServicesR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/_0"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/reset_all_forms" />

    </LinearLayout>
</ScrollView>
