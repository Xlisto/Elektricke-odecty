<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <cz.xlisto.elektrodroid.modules.graphmonth.GraphMonthView
        android:id="@+id/graphMonthView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ln_buttons_monthly_graph"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@color/color_graph_background" />

    <LinearLayout
        android:id="@+id/ln_buttons_monthly_graph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurfaceContainer"
        android:padding="2dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/imgBtnType"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_type"
            android:cropToPadding="false"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_column" />

        <ImageButton
            android:id="@+id/imgBtnPeriod"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_period"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_year" />

        <ImageButton
            android:id="@+id/imgBtnVT"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_vt"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_vt_off" />

        <ImageButton
            android:id="@+id/imgBtnNT"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_nt"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_nt_off" />

        <ImageButton
            android:id="@+id/imgBtnLeft"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_zoom_in"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_month_left_gray" />

        <ImageButton
            android:id="@+id/imgBtnRight"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_btn_zoom_out"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_graph_month_right_gray" />
    </LinearLayout>

</RelativeLayout>