<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_action_card">

    <FrameLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Výchozí kompaktní zobrazení 1×1: ikona + název odběrného místa -->
        <LinearLayout
            android:id="@+id/layout_new_reading_compact"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/iv_widget_action_icon_compact"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/widget_new_reading_action_label"
                android:src="@drawable/ic_widget_add_reading_24" />

            <TextView
                android:id="@+id/tv_widget_point_name_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/md_theme_onPrimaryContainer"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Domov" />
        </LinearLayout>

        <!-- Rozšířené zobrazení při roztažení na 2×1+ -->
        <LinearLayout
            android:id="@+id/layout_new_reading_wide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_widget_action_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add_reading_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_action_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_new_reading_action_label"
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_point_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="11sp"
                    tools:text="Domov" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_warning_24" />

        <TextView
            android:id="@+id/tv_widget_error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Odběrné místo již neexistuje." />
    </LinearLayout>
</FrameLayout>
