<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Produktová řada -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRada"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/sp_produktova_rada"
            app:endIconDrawable="@drawable/ic_expand_more_24"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true"
                tools:text="Všechny" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Produkt -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProdukt"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/sp_produkt"
            app:endIconDrawable="@drawable/ic_expand_more_24"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProdukt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true"
                tools:text="Aku, Akumulace 16" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sazba -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSazba"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/sazba_distribuce"
            app:endIconDrawable="@drawable/ic_expand_more_24"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSazba"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true"
                tools:text="D 25d, D 26d" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dodavatelé -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCompany"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/sp_dodavatele"
            app:endIconDrawable="@drawable/ic_expand_more_24"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true"
                tools:text="ČEZ, E.ON" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Distribuční území -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArea"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/distribucni_uzemi"
            app:endIconDrawable="@drawable/ic_expand_more_24"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true"
                tools:text="EG.D" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Datum platnosti -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/sp_datum_platnosti"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <!-- Datum OD -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDateFrom"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="@string/datum_od"
                app:endIconDrawable="@drawable/ic_calendar_24"
                app:endIconMinSize="36dp"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDateFrom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:lines="1"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:singleLine="true"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform"
                    tools:text="1. 1. 2026" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Datum DO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDateTo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="@string/datum_do"
                app:endIconDrawable="@drawable/ic_calendar_24"
                app:endIconMinSize="36dp"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDateTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:lines="1"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:singleLine="true"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform"
                    tools:text="31. 12. 2026" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Chybové hlášení neplatného rozsahu dat -->
        <TextView
            android:id="@+id/tvDateRangeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/invalid_date_range"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <!-- Rychlé předvolby -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/rychle_predvolby"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllDates"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/vse"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThisYear"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/tento_rok"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    app:chipIconVisible="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLastYear"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/minuly_rok"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNextYear"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/nasledujici_rok"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    app:chipIconVisible="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tlačítko pro výběr rozsahu v kalendáři -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRangePicker"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/vybrat_rozsah_v_kalendari"
            app:icon="@drawable/ic_calendar_24"
            app:iconGravity="textStart" />

        <!-- Tlačítko pro reset filtrů -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetFilter"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/filtr_reset" />

    </LinearLayout>
</ScrollView>
