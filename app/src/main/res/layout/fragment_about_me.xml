<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:name="cz.xlisto.elektrodroid.modules.aboutme.AboutMeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".modules.aboutme.AboutMeFragment">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/llBottomLinks"
        android:padding="5dp"
        app:layoutManager="LinearLayoutManager" />

    <LinearLayout
        android:id="@+id/llBottomLinks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/update_check_button"
            android:textColor="@color/text_link"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRateApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/rate_app"
            android:textColor="@color/text_link"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLinkPrivatePolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/link_private_policy"
            android:textColor="@color/text_link"
            android:textSize="15sp" />
    </LinearLayout>

</RelativeLayout>