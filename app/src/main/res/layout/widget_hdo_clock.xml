<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card">

    <FrameLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Mini režim 1×1: čistý ciferník bez popisků -->
        <FrameLayout
            android:id="@+id/layout_clock_mini"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_widget_clock_mini"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_hdo_clock_name"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Výchozí pruhový režim 2×1 (a 3×1): ciferník vlevo + kompaktní stav vpravo -->
        <LinearLayout
            android:id="@+id/layout_clock_strip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/iv_widget_clock_strip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:contentDescription="@string/widget_hdo_clock_name"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_widget_point_name_strip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Domov" />

                    <ImageView
                        android:id="@+id/btn_widget_config_strip"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/widget_config_button_description"
                        android:padding="2dp"
                        android:src="@drawable/ic_widget_settings_24" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_widget_hdo_status_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="NT • 22:00" />

                <TextView
                    android:id="@+id/tv_widget_hdo_detail_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Zbývá 1h 45m" />
            </LinearLayout>
        </LinearLayout>

        <!-- Větší zobrazení 2×2 a 3×2+: hlavička, velký ciferník a popisky -->
        <LinearLayout
            android:id="@+id/layout_clock_large"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_widget_point_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Domov" />

                <ImageView
                    android:id="@+id/btn_widget_config"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/widget_config_button_description"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_settings_24" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_clock_compact"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_widget_clock_compact"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_hdo_clock_name"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_widget_hdo_next_compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Další: 22:00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_clock_wide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_widget_clock_wide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_hdo_clock_name"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/tv_widget_hdo_tariff_wide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Nízký tarif (NT)" />

                    <TextView
                        android:id="@+id/tv_widget_hdo_next_wide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Další: 22:00" />

                    <TextView
                        android:id="@+id/tv_widget_hdo_remaining_wide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="11sp"
                        tools:text="Zbývá 1h 45m" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_warning_24" />

        <TextView
            android:id="@+id/tv_widget_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_error_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
