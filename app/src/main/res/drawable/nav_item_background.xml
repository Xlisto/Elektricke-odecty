<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="12dp" android:insetTop="2dp" android:insetRight="12dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <solid android:color="@color/nav_menu_item_color_pressed" />
            </shape>
        </inset>
    </item>

    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetTop="2dp" android:insetRight="12dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <solid android:color="@color/nav_menu_item_color_checked" />
            </shape>
        </inset>
    </item>

    <item android:state_activated="true">
        <inset android:insetLeft="12dp" android:insetTop="2dp" android:insetRight="12dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <solid android:color="@color/nav_menu_item_color_checked" />
            </shape>
        </inset>
    </item>

    <item android:drawable="@color/nav_menu_background" />
</selector>
